# Neutral project identity
PROJECT_NAME=sf
PROJECT_USER_AGENT=sf-builder/1.0

# Production should require real Xray checks.
# Locally you may keep it 0 if xray is not installed.
REQUIRE_XRAY=1

# Turso/libSQL publication target. Keep real values only in GitHub Secrets / local env.
TURSO_URL=libsql://example.turso.io
TURSO_TOKEN=replace-me

# Cloudflare Worker / Telegram bot. Keep real values only in secrets.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
PUBLIC_BASE_URL=https://sf.example.workers.dev
PUBLIC_SUB_TOKEN=replace-me
CLOUDFLARE_API_TOKEN=replace-me
CLOUDFLARE_ACCOUNT_ID=replace-me

# Russia reachability check via Globalping.
RU_CHECK_MODE=soft
GLOBALPING_LOCATION=RU
GLOBALPING_LIMIT=50
GLOBALPING_WORKERS=4
GLOBALPING_TIMEOUT=90
