# Neutral project identity
PROJECT_NAME=sf
PROJECT_USER_AGENT=sf-builder/1.0

# Production should require real Xray checks.
# Locally you may keep it 0 if xray is not installed.
REQUIRE_XRAY=1

# Turso/libSQL publication target. Keep real values only in GitHub Secrets / local env.
TURSO_URL=libsql://example.turso.io
TURSO_TOKEN=replace-me

# Cloudflare Worker / Telegram bot (worker.js). Set these in the CF dashboard:
# Workers & Pages -> your worker -> Settings -> Variables and Secrets.
BOT_TOKEN=replace-me                # @BotFather token (secret)
TG_WEBHOOK_SECRET=replace-me        # any random string, protects webhook and /init (secret)
ADMIN_IDS=123456789                 # comma-separated Telegram ids of admins
PUBLIC_BASE_URL=                    # optional: override subscription base URL

# CryptoBot (Crypto Pay API) — optional payment method.
CRYPTOBOT_TOKEN=replace-me          # @CryptoBot -> Crypto Pay -> Create App (secret)

# DonationAlerts — optional payment method (donation with a code).
DA_CLIENT_ID=replace-me             # donationalerts.com/application/clients
DA_CLIENT_SECRET=replace-me         # (secret)
DA_USERNAME=                        # your DA nickname for the donate page link

# Russia reachability check via Globalping.
RU_CHECK_MODE=soft
GLOBALPING_LOCATION=RU
GLOBALPING_LIMIT=50
GLOBALPING_WORKERS=4
GLOBALPING_TIMEOUT=90
